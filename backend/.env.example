# ============================================
# CẤU HÌNH SERVER
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================
# CẤU HÌNH POSTGRESQL (hotel_booking_db)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=hotel_booking_db
DB_SSL=false
# Hoặc dùng chuỗi kết nối duy nhất (ưu tiên nếu có):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_booking_db

# ============================================
# CẤU HÌNH JWT & OTP
# ============================================
JWT_SECRET=thay_doi_chuoi_bi_mat_jwt_dai_va_ngau_nhien_tai_day
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10

# ============================================
# CẤU HÌNH GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# CẤU HÌNH SMTP GỬI EMAIL OTP (Gmail App Password)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="StayWithUs <hoanamtran68@gmail.com>"

# ============================================
# CẤU HÌNH GỬI SMS OTP (Tùy chọn - Twilio)
# Để trống sẽ in mã OTP ra console khi chạy development
# ============================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
